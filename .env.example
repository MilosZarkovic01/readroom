DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Email for signup verification and password reset codes.
# Resend is used on Vercel (free tier). Locally you can use the same key, or SMTP.
RESEND_API_KEY=""
EMAIL_FROM="ReadRoom <onboarding@resend.dev>"

