DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Google OAuth (optional). Use separate clients for Production and Preview.
# Authorized redirect URI: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gmail SMTP for signup verification and password reset codes.
# Create a dedicated Gmail for the app, enable 2-Step Verification,
# then add an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="readroom.app@gmail.com"
SMTP_PASS=""
EMAIL_FROM="ReadRoom <readroom.app@gmail.com>"

# Daily goal reminders at 20:00 UTC. Hobby plans reject more frequent crons.
# Vercel sends this as Authorization: Bearer <CRON_SECRET>.
# Lead times are hours before the day, week, or deadline ends.
CRON_SECRET=""
GOAL_REMINDER_ENABLED="true"
GOAL_REMINDER_DAILY_LEAD_HOURS="3"
GOAL_REMINDER_WEEKLY_LEAD_HOURS="24"
GOAL_REMINDER_TOTAL_LEAD_HOURS="48"
