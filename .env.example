DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Gmail SMTP for signup verification and password reset codes.
# Create a dedicated Gmail for the app, enable 2-Step Verification,
# then add an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="readroom.app@gmail.com"
SMTP_PASS=""
EMAIL_FROM="ReadRoom <readroom.app@gmail.com>"
