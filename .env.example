# Local Docker Postgres (see docker-compose.yml). On Vercel, Neon injects these.
DATABASE_URL="postgresql://readroom:readroom@localhost:5432/readroom?schema=public"
DATABASE_URL_UNPOOLED="postgresql://readroom:readroom@localhost:5432/readroom?schema=public"

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Local default. On Vercel, set this to your production URL (https://your-app.vercel.app).
AUTH_URL="http://localhost:3000"
